<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site "RPT"  ->  physical path C:\RPT\iis  ->  binding http://*:7272
  Reverse-proxies every request to the Flask backend that NSSM runs on
  http://127.0.0.1:7373 (service "RPT-Backend").

  Prerequisites installed/enabled by deploy\Deploy-Server.ps1:
    - IIS with URL Rewrite 2.1 and Application Request Routing 3.0
    - ARR server-level proxy enabled  (system.webServer/proxy @enabled = true)
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="RPT-ReverseProxy" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:7373/{R:1}"
                  logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- 500 MB: allow the largest RPT SOA PDFs through IIS -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
