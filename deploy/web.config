<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template - deploy-iis.ps1 copies this into C:\RPT\iis\web.config after each
  deploy, replacing __BACKEND_PORT__ with the actual backend port.

  Unlike cwt-tax-portal (which serves a static client build and only proxies
  /api/*), the RPT app's Flask backend renders every page itself, so IIS just
  reverse-proxies everything to it.

  Requires IIS URL Rewrite + Application Request Routing (ARR), with ARR
  proxying enabled at the server level (deploy-iis.ps1 does this).
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="ReverseProxyToRptBackend" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:__BACKEND_PORT__/{R:1}"
                  logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- 500 MB - the largest real RPT SOA PDFs -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
