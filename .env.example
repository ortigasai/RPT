# Copy to .env and adjust. .env is git-ignored.

RPT_PORT=5000
RPT_HOST=0.0.0.0

# A local PostgreSQL, or the shared tax-server database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/RPT

# Prompters API broker (Permits & Registrations). Ask the key holder.
RPT_BROKER_URL=https://paba.ortigasland.com.ph/api/v1
RPT_BROKER_KEY=
RPT_BROKER_SCOPE=perm-reg-api

RPT_OCR_BACKEND=paddle

# Shared login - leave blank to run open (dev).
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
