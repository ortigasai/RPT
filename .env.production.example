# Template for the SERVER's .env - copy to C:\RPT\.env and fill in real values.
# Never commit the filled-in file (.env is git-ignored). It reaches the server
# via deploy\migrate-data.ps1, not git.

# Backend port. Must match -BackendPort in deploy\deploy-iis.ps1 (7373) and the
# port the reverse-proxy rule in deploy\web.config targets. Bind to localhost -
# only IIS (:7272) is public.
RPT_PORT=7373
RPT_HOST=127.0.0.1

# The tax server's PostgreSQL "RPT" database. Same instance the cwt-tax-portal
# uses (192.168.0.215). Ask whoever manages that Postgres for the password.
# The value is URL-encoded (e.g. '@' -> %40).
DATABASE_URL=postgresql://postgres:<url-encoded-password>@192.168.0.215:5432/RPT

# Prompters API broker - copy the same values from the dev laptop's .env
# (the key is tied to the scope/holder, not the machine).
RPT_BROKER_URL=https://paba.ortigasland.com.ph/api/v1
RPT_BROKER_KEY=
RPT_BROKER_SCOPE=perm-reg-api

RPT_OCR_BACKEND=paddle

# Bundled OCR assets laid down by migrate-data.ps1 (leave unset to let the
# service download PaddleOCR models on first run / winget-install Tesseract).
RPT_PADDLE_MODELS=C:/RPT/models/paddleocr
TESSERACT_CMD=C:/RPT/vendor/Tesseract-OCR/tesseract.exe

# HOME for the NSSM service (LocalSystem's real profile isn't writable). This
# is where PaddleOCR keeps its cache when RPT_PADDLE_MODELS isn't set.
# deploy\deploy-iis.ps1 also sets this on the service itself.
USERPROFILE=C:/RPT/home

# Shared login (same one the tax team uses for cwt-tax-portal: cwtportal).
# The hash below is bcrypt("taxteam2026!"). Leave both blank to run open.
AUTH_USERNAME=cwtportal
AUTH_PASSWORD_HASH=$2b$10$MulFszs1dyWa8/BXRJh6AuVpfHRrNa0PDdGPrWsKZ/Gw3Y6QQOwya
