# ---- secrets / local config - never commit ----
.env
.env.local
.env.production
broker_config.json

# ---- python env ----
.venv/
venv/
__pycache__/
*.pyc
*.pyo
requirements.lock.txt

# ---- runtime / generated ----
logs/
*.xlsx
*.log

